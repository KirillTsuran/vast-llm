// Ships every service log to Loki (all local to the GPU machine).
local.file_match "llm" {
  path_targets = [{"__path__" = "/var/log/llm/*.log"}]
}

loki.source.file "llm" {
  targets    = local.file_match.llm.targets
  forward_to = [loki.process.llm.receiver]
}

loki.process "llm" {
  // benign noise: Loki/Grafana log every query cancelled by a dashboard refresh as an error
  stage.drop {
    expression          = "context canceled|error notifying scheduler about finished query|Partial data response error|Plugin Request Completed"
    drop_counter_reason = "query_cancel_noise"
  }
  // benign one-time startup messages (udev is absent in containers; Loki logs these until its ring is ready,
  // and Grafana's first label lookup fails while Loki is still starting)
  stage.drop {
    expression          = "disabling udev device properties|empty ring|error health checking|resources/label/service/values status=500"
    drop_counter_reason = "startup_noise"
  }
  // service name from the file name: /var/log/llm/strata.log -> strata
  stage.regex {
    expression = "/var/log/llm/(?P<service>[a-z_]+)"
    source     = "filename"
  }
  stage.labels {
    values = {service = ""}
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
