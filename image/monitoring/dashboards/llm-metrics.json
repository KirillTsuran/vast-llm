    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Скорость, токенов в секунду",
   "description": "«Читает запрос» — обработка нового текста запроса (всплески при длинных вопросах), «пишет ответ» — генерация",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "expr": "sum(rate(llm_generated_tokens_total[1m]))",
     "legendFormat": "пишет ответ",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "sum(rate(llm_prompt_tokens_total[1m]))",
     "legendFormat": "читает запрос",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Ответы по итогу, штук за минуту",
   "description": "Каждый столбик — сколько ответов закончилось за минуту и как",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "expr": "sum(increase(llm_requests_finished_total{reason=\"stop_token\"}[1m])) or vector(0)",
     "legendFormat": "нормально завершён",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "sum(increase(llm_requests_finished_total{reason=\"max_new_tokens\"}[1m])) or vector(0)",
     "legendFormat": "упёрся в лимит длины",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "sum(increase(llm_requests_finished_total{reason=\"loop_detected\"}[1m])) or vector(0)",
     "legendFormat": "оборван: зацикливание",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "sum(increase(llm_requests_finished_total{reason!~\"stop_token|max_new_tokens|loop_detected\"}[1m])) or vector(0)",
     "legendFormat": "прочее",
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 60,
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1m"
  },
