   },
   "targets": [
    {
     "expr": "max(up{job=\"tabby\"}) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "не работает",
         "color": "red"
        },
        "1": {
         "text": "работает",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
