    }
   }
  },
  {
   "type": "timeseries",
   "title": "Мощность (Вт) и температура (°C)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "expr": "llm_gpu_power_watts",
     "legendFormat": "Вт",
     "refId": "A",
     "datasource": {
