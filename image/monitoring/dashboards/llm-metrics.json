{
 "uid": "llm-metrics",
 "title": "LLM — метрики",
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "panels": [
  {
   "type": "row",
   "title": "Сейчас",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Скорость, ток/с",
   "description": "Средняя скорость написания ответов за последний час: все токены ответов / всё время их написания. Простой не учитывается",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(llm_generated_tokens_total[1h])) / (sum(increase(llm_decode_seconds_total[1h])) > 0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "mappings": [],
     "noValue": "нет ответов"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Ответов за час",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` [1h])) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Пишет сейчас",
   "description": "Сколько запросов модель обрабатывает прямо сейчас (0 или 1)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(llm_requests_processing) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "purple"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Зацикливаний за сутки",
   "description": "Ответы, оборванные с ошибкой generation_loop_detected. Норма — 0",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json reason=\"metrics.eos_reason\" | reason=\"loop_detected\" [24h])) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "LoopBreak спас, раз",
   "description": "За сутки: сколько раз защита прервала повтор в рассуждении, и ответ продолжился нормально",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(llm_loopbreak_events_total[24h])) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Загрузка GPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "llm_gpu_util_percent",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "yellow"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "row",
   "title": "Модель: скорость (каждая точка — один ответ, в момент его окончания)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Скорость ответа, ток/с",
   "description": "Токенов в секунду, пока модель писала этот ответ (считает сам движок). Обычно 40–110: чем лучше DFlash2 угадывает, тем быстрее",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "expr": "max by () (max_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json v=\"metrics.gen_tokens_per_sec\" | unwrap v | __error__=\"\" [$__interval]))",
     "legendFormat": "пишет ответ",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "drawStyle": "points",
      "pointSize": 9,
      "showPoints": "always",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "15s"
  },
  {
   "type": "timeseries",
   "title": "Скорость чтения запроса, ток/с",
   "description": "Как быстро модель прочитала новую часть запроса (то, чего не было в кэше). Только запросы с новой частью от 1000 токенов: на коротких скорость не показательна",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "expr": "max by () (max_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json v=\"metrics.prompt_tokens_per_sec\", p=\"metrics.prompt_tokens\", c=\"metrics.cached_tokens\" | label_format n=`{{ subf .p .c }}` | n >= 1000 | unwrap v | __error__=\"\" [$__interval]))",
     "legendFormat": "читает запрос",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "drawStyle": "points",
      "pointSize": 9,
      "showPoints": "always",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "15s"
  },
  {
   "type": "timeseries",
   "title": "Ожидание первого токена, с",
   "description": "Сколько секунд прошло от запроса до начала ответа: ожидание в очереди (пока модель занята другим запросом) плюс чтение запроса. «В очереди» показан, только если ожидание было",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "expr": "max by () (max_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json q=\"metrics.queue_time\", p=\"metrics.prompt_time\" | label_format v=`{{ addf .q .p }}` | unwrap v | __error__=\"\" [$__interval]))",
     "legendFormat": "всего",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    },
    {
     "expr": "max by () (max_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json v=\"metrics.queue_time\" | v > 0.1 | unwrap v | __error__=\"\" [$__interval]))",
     "legendFormat": "из них в очереди",
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "drawStyle": "points",
      "pointSize": 9,
      "showPoints": "always",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "15s"
  },
  {
   "type": "row",
   "title": "Модель: ответы и память",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Ответы по итогу, штук",
   "description": "Каждый столбик — сколько ответов закончилось за 5 минут и как. Отменённые клиентом запросы не считаются",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json reason=\"metrics.eos_reason\" | reason=\"stop_token\" [$__interval]))",
     "legendFormat": "нормально завершён",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    },
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json reason=\"metrics.eos_reason\" | reason=\"max_new_tokens\" [$__interval]))",
     "legendFormat": "упёрся в лимит длины",
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    },
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json reason=\"metrics.eos_reason\" | reason=\"loop_detected\" [$__interval]))",
     "legendFormat": "оборван: зацикливание",
     "refId": "C",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    },
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json reason=\"metrics.eos_reason\" | reason!~\"stop_token|max_new_tokens|loop_detected\" [$__interval]))",
     "legendFormat": "прочее",
     "refId": "D",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 60,
      "drawStyle": "bars",
      "pointSize": 5,
      "showPoints": "auto",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "5m"
  },
  {
   "type": "timeseries",
   "title": "DFlash2 угадал токенов, %",
   "description": "Доля черновых токенов маленькой модели-помощника, которые основная модель приняла, в каждом ответе. Чем выше, тем быстрее ответ",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 8,
    "y": 17,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "expr": "max by () (max_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json a=\"metrics.draft_accept\", r=\"metrics.draft_reject\" | a > 0 | label_format v=`{{ divf (mulf 100 .a) (addf .a .r) }}` | unwrap v | __error__=\"\" [$__interval]))",
     "legendFormat": "угадано",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "drawStyle": "points",
      "pointSize": 9,
      "showPoints": "always",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "15s"
  },
  {
   "type": "timeseries",
   "title": "Память контекста, токенов",
   "description": "Сколько токенов диалога сейчас держит модель. Когда «занято» подходит к максимуму, длинный диалог надо сжимать",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 17,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "expr": "llm_cache_used_tokens",
     "legendFormat": "занято сейчас",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "llm_context_tokens",
     "legendFormat": "максимум (112K)",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "drawStyle": "line",
      "pointSize": 5,
      "showPoints": "auto",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Видеокарта",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Видеопамять, МиБ",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
