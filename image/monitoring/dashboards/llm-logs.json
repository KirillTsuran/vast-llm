{
 "uid": "llm-logs",
 "title": "LLM — логи",
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "panels": [
  {
   "type": "row",
   "title": "Обзор",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Ответов за час",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` [1h])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "orientation": "vertical"
   }
  },
  {
   "type": "stat",
   "title": "Ошибок в логах за час",
   "description": "Строки с уровнем error, critical или fatal во всех сервисах, включая оборванные зацикливанием ответы",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} | detected_level=~\"error|critical|fatal\" [1h])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "orientation": "vertical"
   }
  },
  {
   "type": "stat",
   "title": "Зацикливаний, сутки",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json reason=\"metrics.eos_reason\" | reason=\"loop_detected\" [24h])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "orientation": "vertical"
   }
  },
  {
   "type": "stat",
   "title": "Строк логов за 15 мин",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} [15m])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "orientation": "vertical"
   }
  },
  {
   "type": "logs",
   "title": "Ответы модели (одна строка на запрос)",
   "description": "Итог каждого запроса: сколько ждал в очереди, сколько читал, сколько и как быстро писал ответ",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "expr": "{event=\"generation_end\"} | json | line_format `{{ if .metrics_partial }}отменён клиентом после {{ .metrics_observed_output_tokens }} ток{{ else }}{{ if eq .metrics_eos_reason \"stop_token\" }}готов{{ else if eq .metrics_eos_reason \"max_new_tokens\" }}упёрся в лимит длины{{ else if eq .metrics_eos_reason \"loop_detected\" }}ОБОРВАН: зацикливание{{ else }}{{ .metrics_eos_reason }}{{ end }} · запрос {{ .metrics_prompt_tokens }} ток (новых {{ subf .metrics_prompt_tokens .metrics_cached_tokens }}) · очередь {{ .metrics_queue_time }} с · чтение {{ .metrics_prompt_time }} с · ответ {{ .metrics_gen_tokens }} ток за {{ .metrics_gen_time }} с ({{ .metrics_gen_tokens_per_sec }} ток/с){{ end }}`",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   }
  },
  {
   "type": "timeseries",
   "title": "Объём логов по сервисам, строк",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum by (service) (count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} [$__interval]))",
     "legendFormat": "{{service}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "decimals": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 70,
      "drawStyle": "bars",
      "lineInterpolation": "smooth",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1m"
  },
  {
   "type": "timeseries",
   "title": "Ошибки по сервисам, строк",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum by (service) (count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} | detected_level=~\"error|critical|fatal\" [$__interval]))",
     "legendFormat": "{{service}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "decimals": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 70,
      "drawStyle": "bars",
      "lineInterpolation": "smooth",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "5m"
  },
  {
   "type": "row",
   "title": "Логи",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "logs",
   "title": "Только ошибки",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "expr": "{service=~\"$service\", event!~\"request_body|response_body\"} | detected_level=~\"error|critical|fatal\"",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   }
  },
  {
   "type": "logs",
   "title": "Все логи (вверху: выбрать Сервис и Найти текст)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "expr": "{service=~\"$service\", event!~\"request_body|response_body\"} |~ \"(?i)$search\"",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   }
  }
 ],
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "service",
    "label": "Сервис",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "service",
     "type": 1,
     "stream": "",
     "refId": "svc"
    },
    "definition": "label_values(service)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "type": "textbox",
    "name": "search",
    "label": "Найти текст",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "LLM — метрики",
