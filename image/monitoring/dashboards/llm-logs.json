{
 "uid": "llm-logs",
 "title": "LLM — логи",
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "panels": [
  {
   "type": "row",
   "title": "Обзор",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Ответов за час",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` [1h])) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Ошибок в логах за час",
   "description": "Строки уровня error, exception, traceback, out of memory, loop_detected во всех сервисах",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} |~ `(?i)(level=error|level=ERROR|\"level\": \"error\"|exception|traceback|out of memory|loop_detected)` [1h])) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Зацикливаний за сутки",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({event=\"generation_end\"} !~ `\"partial\": true` | json reason=\"metrics.eos_reason\" | reason=\"loop_detected\" [24h])) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Строк логов за 15 мин",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} [15m])) or vector(0)",
     "refId": "A",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "logs",
   "title": "Ответы модели (одна строка на ответ)",
   "description": "stop_token — ответ завершён нормально; max_new_tokens — упёрся в лимит длины; loop_detected — оборван из-за зацикливания",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "expr": "{job=\"requests\", event=\"generation_end\"} | json | line_format `итог: {{.metrics_eos_reason}} · вход {{.metrics_prompt_tokens}} ток (из кэша {{.metrics_cached_tokens}}) · ответ {{.metrics_gen_tokens}} ток · {{.metrics_gen_tokens_per_sec}} ток/с · всего {{.metrics_total_time}} с · контекст {{.context_len}}`",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   }
  },
  {
   "type": "timeseries",
   "title": "Объём логов по сервисам, строк в минуту",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "expr": "sum by (service) (count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} [1m]))",
     "legendFormat": "{{service}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 60,
      "drawStyle": "bars",
      "pointSize": 5,
      "showPoints": "auto",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Ошибки по сервисам, за 5 минут",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "expr": "sum by (service) (count_over_time({service=~\"$service\", event!~\"request_body|response_body\"} |~ `(?i)(level=error|level=ERROR|\"level\": \"error\"|exception|traceback|out of memory|loop_detected)` [5m]))",
     "legendFormat": "{{service}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 60,
      "drawStyle": "bars",
      "pointSize": 5,
      "showPoints": "auto",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Логи",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 1
   },
   "panels": []
