 ],
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "service",
    "label": "Сервис",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "service",
     "type": 1,
     "stream": "",
     "refId": "svc"
    },
    "definition": "label_values(service)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
