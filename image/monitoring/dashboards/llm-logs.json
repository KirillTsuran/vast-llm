     "expr": "{service=~\"$service\", event!~\"request_body|response_body\"} |~ `(?i)(level=error|level=ERROR|\"level\": \"error\"|exception|traceback|out of memory|loop_detected)`",
     "refId": "A",
     "datasource": {
      "type": "loki",
